# =============================================================================
# AEGIS AI — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# --- Application ---
APP_NAME=AEGIS AI
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Clerk Authentication ---
# Frontend keys (also copy to apps/web/.env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Backend Clerk JWT verification — from Clerk Dashboard → API Keys → JWKS URL
# Format: https://<your-clerk-domain>/.well-known/jwks.json
CLERK_JWKS_URL=
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# --- PostgreSQL (PostGIS) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_DB=aegis
DATABASE_URL=postgresql+asyncpg://aegis:aegis_dev_password@localhost:5432/aegis

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aegis_neo4j_password

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=aegis_minio
S3_SECRET_KEY=aegis_minio_secret
S3_BUCKET=aegis-uploads
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.2

# --- Mapbox ---
MAPBOX_ACCESS_TOKEN=

# --- JWT Auth (legacy — Clerk handles frontend auth) ---
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Notifications (optional for Phase 0) ---
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- External Feeds (optional for Phase 0) ---
FEMA_API_KEY=
NOAA_API_KEY=
